	"item": [
		{
			"name": "Authentication",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"",
							"if (jsonData && jsonData.access_token) {",
							"    pm.environment.set(\"access_token\", jsonData.access_token);",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/x-www-form-urlencoded",
						"type": "text"
					}
				],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{
							"key": "grant_type",
							"value": "client_credentials",
							"type": "text"
						},
						{
							"key": "audience",
							"value": "{{ZEEBE_TOKEN_AUDIENCE}}",
							"type": "text"
						},
						{
							"key": "client_id",
							"value": "{{ZEEBE_CLIENT_ID}}",
							"type": "text"
						},
						{
							"key": "client_secret",
							"value": "{{ZEEBE_CLIENT_SECRET}}",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{ZEEBE_AUTHORIZATION_SERVER_URL}}",
					"host": [
						"{{ZEEBE_AUTHORIZATION_SERVER_URL}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Start process",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Generate a random 6-digit number as a string",
							"var orderId = Math.floor(Math.random() * 900000 + 100000).toString();",
							"//var orderId = 834783",
							"// Set the orderId as an environment variable",
							"pm.environment.set(\"orderId\", orderId);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{access_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"processDefinitionId\": \"PaymentProcess\",\n  \"processDefinitionVersion\": -1,\n  \"variables\": {\"orderTotal\":45.99, \"customerCredit\": 30}\n}"
				},
				"url": {
					"raw": "{{ZEEBE_REST_ADDRESS}}/v2/process-instances",
					"host": [
						"{{ZEEBE_REST_ADDRESS}}"
					],
					"path": [
						"v2",
						"process-instances"
					]
				}
			},
			"response": []
		},
